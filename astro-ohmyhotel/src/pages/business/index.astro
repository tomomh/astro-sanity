---
import MainLayout from '../../layouts/main.astro';
import ProductCard from '../../components/business/ProductCard.astro';
import { getLangFromUrl, buildUrlWithLang, type Language } from '../../utils/i18n';
import { fetchProductsList } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';

const lang = getLangFromUrl(Astro.url);

// Fetch products from Sanity
const sanityProducts = await fetchProductsList();

// Map Sanity products to display format
const productsFromSanity = sanityProducts?.map((product: any) => ({
  title: getLocalizedValue(product.title, lang) || product.title,
  description: getLocalizedValue(product.shortDescription, lang) || product.shortDescription,
  image: product.logo ? urlFor(product.logo).width(400).auto('format').url() : '/images/business/default.jpg',
  slug: product.slug?.current || product.slug
})) || [];

// Fallback products
const fallbackProducts = [
  {
    title: "OTA (Online Travel Agency)",
    description: "Comprehensive B2C platform Ohmyhotel.com and Ohmytrip.com in multiple languages",
    image: "/images/business/ota.jpg",
    slug: "ota"
  },
  {
    title: "PMS (Property Management System)",
    description: "Convenient reservation check and intuitive accommodation management",
    image: "/images/business/pms.jpg",
    slug: "pms"
  },
  {
    title: "CMS (Channel Management System)",
    description: "Efficient rate/inventory management with simple interface",
    image: "/images/business/cms.jpg",
    slug: "cms"
  },
  {
    title: "Booking Engine",
    description: "Powerful booking engine for direct bookings on your website",
    image: "/images/business/booking-engine.jpg",
    slug: "booking-engine"
  },
  {
    title: "Hotel Website Design",
    description: "Modern, responsive website design for hotels",
    image: "/images/business/website.jpg",
    slug: "hotel-web"
  },
  {
    title: "Company Profile",
    description: "OHMY SaaS - One-Stop Solution for hospitality systems",
    image: "/images/business/company-profile.jpg",
    slug: "company-profile"
  }
];

// Use Sanity data or fallback
const products = productsFromSanity.length > 0 ? productsFromSanity : fallbackProducts;
---

<MainLayout content={{ title: 'Our Business - OHMYHOTEL & CO' }}>
  <div class="business-page">
    <section class="hero">
      <h1>Our Business</h1>
      <p>Comprehensive Hotel Technology Solutions</p>
    </section>

    <div class="container">
      <div class="intro-section">
        <h2>All-in-one, Seamless Solution</h2>
        <p>From purchasing to selling, we provide a complete one-stop solution for the hospitality industry.</p>
      </div>

      <div class="products-grid">
        {products.map((product) => (
          <ProductCard
            title={product.title}
            description={product.description}
            image={product.image}
            link={buildUrlWithLang(`/business/${product.slug}`, lang)}
          />
        ))}
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .business-page {
    min-height: 100vh;
    background-color: #F7FAFD;
  }

  .hero {
    padding: 0 2rem;
    min-height: 21rem;
    background:
      url("/images/logo/orange.svg") 10% -5% no-repeat,
      url("/images/logo/orange.svg") 90% 115% no-repeat,
      url("/images/business/business-banner.jpg") center center;
    background-size: 374px auto, 523px auto, cover;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    color: white;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: white;
  }

  .hero p {
    font-size: 1.25rem;
    opacity: 0.95;
    color: white;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .intro-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .intro-section h2 {
    font-size: 2rem;
    font-weight: 600;
    color: #2c2c2c;
    margin-bottom: 1rem;
  }

  .intro-section p {
    font-size: 1.1rem;
    color: #444444;
    max-width: 800px;
    margin: 0 auto;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 991px) {
    .hero {
      background-position: -28% -5%, 185% 115%, center center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 16rem;
      padding: 2rem 1.5rem;
      background-position: -10rem -34%, calc(100% + 18rem) 165%, center center;
      background-size: 281px auto, 310px auto, cover;
    }

    .hero h1 {
      font-size: 1.75rem;
    }

    .hero p {
      font-size: 1rem;
    }

    .intro-section h2 {
      font-size: 1.5rem;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }

    .container {
      padding: 2rem 1rem;
    }
  }
</style>
