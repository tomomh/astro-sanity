---
import MainLayout from '../../layouts/main.astro';
import AboutUsBanner from '../../components/about/AboutUsBanner.astro';
import SubMenu from '../../components/about/SubMenu.astro';
import Location from '../../components/about/Location.astro';
import { getLangFromUrl } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
---

<MainLayout content={{ title: 'Locations - OHMYHOTEL & CO' }}>
  <AboutUsBanner lang={lang} />
  <SubMenu lang={lang} activeItem="location" />
  <Location lang={lang} />
</MainLayout>
