---
import MainLayout from '../../layouts/main.astro';
import AboutUsBanner from '../../components/about/AboutUsBanner.astro';
import SubMenu from '../../components/about/SubMenu.astro';
import CEOMessage from '../../components/about/CEOMessage.astro';
import { getLangFromUrl } from '../../utils/i18n';

const lang = getLangFromUrl(Astro.url);
---

<MainLayout content={{ title: 'CEO Message - OHMYHOTEL & CO' }}>
  <AboutUsBanner lang={lang} />
  <SubMenu lang={lang} activeItem="ceo-message" />
  <CEOMessage lang={lang} />
</MainLayout>
