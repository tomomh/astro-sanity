---
import MainLayout from '../../../layouts/main.astro';
import AboutUsBanner from '../../../components/about/AboutUsBanner.astro';
import SubMenu from '../../../components/about/SubMenu.astro';
import CorporateIdentity from '../../../components/about/CorporateIdentity.astro';
import { languages, type Language } from '../../../utils/i18n';

export async function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
---

<MainLayout content={{ title: 'Corporate Identity - OHMYHOTEL & CO' }}>
  <AboutUsBanner lang={lang} />
  <SubMenu lang={lang} activeItem="ci" />
  <CorporateIdentity lang={lang} />
</MainLayout>
