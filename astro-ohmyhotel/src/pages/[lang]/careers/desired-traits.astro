---
import PageLayout from '../../../layouts/PageLayout.astro';
import DesiredTraits from '../../../components/careers/DesiredTraits.astro';
import type { Language } from '../../../utils/i18n';
import { languages } from '../../../utils/i18n';

export async function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Language };

const pageTitle: Record<Language, string> = {
  en: 'Desired Traits',
  ja: '求める人材像',
  ko: '인재상',
  vi: 'Phẩm chất mong muốn'
};

const bannerContent: Record<Language, { title: string; subtitle: string }> = {
  en: {
    title: 'Who We Look For',
    subtitle: 'We seek passionate individuals who share our values'
  },
  ja: {
    title: '私たちが求める人材',
    subtitle: '私たちの価値観を共有する情熱的な人材を求めています'
  },
  ko: {
    title: '우리가 찾는 인재',
    subtitle: '우리의 가치를 공유하는 열정적인 인재를 찾습니다'
  },
  vi: {
    title: 'Chúng tôi tìm kiếm ai',
    subtitle: 'Chúng tôi tìm kiếm những cá nhân nhiệt huyết chia sẻ giá trị của chúng tôi'
  }
};
---

<PageLayout title={pageTitle[lang]} lang={lang}>
  <div class="desired-traits-page">
    <section class="page-banner">
      <div class="banner-content">
        <h1>{bannerContent[lang].title}</h1>
        <p>{bannerContent[lang].subtitle}</p>
      </div>
    </section>

    <DesiredTraits lang={lang} />
  </div>
</PageLayout>

<style>
  .desired-traits-page {
    min-height: 100vh;
  }

  .page-banner {
    background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    color: white;
    padding: 6rem 2rem;
    text-align: center;
  }

  .banner-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-banner h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .page-banner p {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .page-banner {
      padding: 4rem 1.5rem;
    }

    .page-banner h1 {
      font-size: 2rem;
    }

    .page-banner p {
      font-size: 1rem;
    }
  }
</style>
