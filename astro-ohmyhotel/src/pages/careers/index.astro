---
import PageLayout from '../../layouts/PageLayout.astro';
import DesiredTraits from '../../components/careers/DesiredTraits.astro';
import JobList from '../../components/careers/JobList.astro';
import { getLangFromUrl, type Language } from '../../utils/i18n';
import { fetchCareersPage } from '../../utils/queries';
import { getLocalizedValue } from '../../utils/sanity';

const lang = getLangFromUrl(Astro.url);

// Fetch careers page data from Sanity
const careersPage = await fetchCareersPage();

// Get localized values from Sanity
const sanityBannerTitle = getLocalizedValue(careersPage?.banner?.title, lang);
const sanityBannerSubtitle = getLocalizedValue(careersPage?.banner?.subtitle, lang);

// Fallback content
const fallbackPageTitle: Record<Language, string> = {
  en: 'Careers',
  ja: '採用情報',
  ko: '채용',
  vi: 'Tuyển dụng'
};

const fallbackBannerContent: Record<Language, { title: string; subtitle: string }> = {
  en: {
    title: 'Join Our Team',
    subtitle: 'Be part of a company that values innovation and growth'
  },
  ja: {
    title: '私たちのチームに参加',
    subtitle: 'イノベーションと成長を重視する会社の一員になりましょう'
  },
  ko: {
    title: '우리 팀에 합류하세요',
    subtitle: '혁신과 성장을 중시하는 회사의 일원이 되세요'
  },
  vi: {
    title: 'Gia nhập đội ngũ của chúng tôi',
    subtitle: 'Trở thành một phần của công ty coi trọng đổi mới và phát triển'
  }
};

// Use Sanity data or fallback
const pageTitle = fallbackPageTitle[lang];
const bannerTitle = sanityBannerTitle || fallbackBannerContent[lang].title;
const bannerSubtitle = sanityBannerSubtitle || fallbackBannerContent[lang].subtitle;
---

<PageLayout title={pageTitle} lang={lang}>
  <div class="careers-page">
    <section class="career-banner">
      <div class="banner-content">
        <h1>{bannerTitle}</h1>
        <p>{bannerSubtitle}</p>
      </div>
    </section>

    <DesiredTraits lang={lang} />
    <JobList lang={lang} />
  </div>
</PageLayout>

<style>
  .careers-page {
    min-height: 100vh;
    background-color: #F7FAFD;
  }

  .career-banner {
    padding: 0 2rem;
    min-height: 21rem;
    background:
      url("/images/logo/orange.svg") 10% -3% no-repeat,
      url("/images/logo/orange.svg") 90% 115% no-repeat,
      url("/images/career/banner.jpg") center 39%;
    background-size: 374px auto, 523px auto, cover;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    color: white;
  }

  .banner-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .career-banner h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: white;
  }

  .career-banner p {
    font-size: 1.25rem;
    opacity: 0.95;
    color: white;
  }

  @media (max-width: 991px) {
    .career-banner {
      background-position: -28% -5%, 185% 115%, center 39%;
    }
  }

  @media (max-width: 768px) {
    .career-banner {
      min-height: 16rem;
      padding: 2rem 1.5rem;
      background-position: -10rem -34%, calc(100% + 18rem) 165%, center 20%;
      background-size: 281px auto, 310px auto, cover;
    }

    .career-banner h1 {
      font-size: 1.75rem;
    }

    .career-banner p {
      font-size: 1rem;
    }
  }
</style>
