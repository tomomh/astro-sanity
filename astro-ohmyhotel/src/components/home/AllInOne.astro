---
import { fetchHomePage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const homePage = await fetchHomePage();

// Get localized values with fallbacks
const header = getLocalizedValue(homePage?.allInOneTitle, lang);
const subtitle = getLocalizedValue(homePage?.allInOneSubtitle, lang);


// Use Sanity data (content now fully managed in Sanity)
const displayHeader = header || '';

// Get products from Sanity allInOneFeatures
const products = homePage?.allInOneFeatures?.map((feature: any, index: number) => ({
  icon: feature.icon ? urlFor(feature.icon).width(80).auto('format').url() : '/images/home/booking-engine.svg',
  title: getLocalizedValue(feature.title, lang) || '',
  content: getLocalizedValue(feature.content, lang) || '',
  link: feature.link || `/${lang}/business`,
  learnMore: getLocalizedValue(feature.learnMore, lang) || 'Learn more'
})) || [];
---

<section class="all-in-one-section">
  <div class="section-header">
    <h3>{displayHeader}</h3>
    <span class="header-line"></span>
  </div>
  <div class="container">
    <div class="section-content">
      <div class="products-grid">
        {products.map((product: any) => (
          <div class="product-card">
            <div class="item-icon">
              <img src={product.icon} alt={product.title} />
            </div>
            <h6 class="p-title">{product.title}</h6>
            <div class="p-content" set:html={product.content}></div>
            <a href={product.link} class="learn-more">
              {product.learnMore}
              <img src="/images/icons/chevron.svg" alt=">" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .all-in-one-section {
    padding-top: 27rem;
    margin-top: -22.5rem;
    padding-bottom: 6rem;
    background:
      url("/images/home/section-line.svg") center -1px no-repeat,
      url("/images/home/seamless-solution-bg.svg") calc(100% + 250px) 35% no-repeat,
      url("/images/home/seamless-solution-bg.svg") -315px 35% no-repeat,
      linear-gradient(180deg, var(--background-color-lightblue) 0px, #fff 44rem);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h3 {
    font-size: 3rem;
    font-weight: 400;
    color: var(--primary-header-color);
    margin-bottom: 2rem;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-content .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    justify-content: center;
  }

  .product-card {
    background: transparent;
    border: none;
    padding: 0 3.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .product-card:nth-child(n + 4) {
    border-top: var(--primary-border);
    padding-top: 4rem;
  }

  .item-icon {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    background: white;
    box-shadow: var(--primary-box-shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .item-icon img {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
  }

  .p-title {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--primary-header-color);
    margin-bottom: 1.5rem;
  }

  .p-content {
    font-size: 1.4rem;
    color: var(--primary-text-color);
    line-height: 1.6;
    text-align: center;
  }

  .p-content :global(ul) {
    list-style: disc;
    margin: 0;
    text-align: left;
    padding-left: 1.5rem;
  }

  .p-content :global(li) {
    line-height: 1.2;
    padding-bottom: 1rem;
  }

  .p-content :global(p) {
    margin-bottom: 0.5rem;
  }

  .learn-more {
    display: inline-flex;
    align-items: center;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--primary-header-color);
    text-decoration: none;
    margin-top: 1rem;
    line-height: 1;
    padding-bottom: 0.3rem;
  }

  .learn-more img {
    margin-left: 0.8rem;
    width: 1.2rem;
    height: auto;
    transition: transform 0.3s ease;
  }

  .learn-more:hover img {
    transform: translateX(4px);
  }

  @media (max-width: 991px) {
    .section-content .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .product-card:nth-child(n + 3) {
      position: relative;
      padding-top: 4rem;
      border-top: none;
    }

    .product-card:nth-child(n + 3)::after {
      content: "";
      height: 1px;
      width: 100%;
      background: linear-gradient(270deg, #ffffff 0%, #e3e3e3 51.39%, #ffffff 100%);
      position: absolute;
      top: 0;
      left: 0;
    }
  }

  @media (max-width: 767px) {
    .all-in-one-section {
      padding-top: 27rem;
      margin-top: -22.5rem;
      background:
        url("/images/home/section-line.svg") center -1px no-repeat,
        url("/images/home/seamless-solution-bg.svg") calc(100% + 370px) 0% repeat-y,
        url("/images/home/seamless-solution-bg.svg") -515px 0% repeat-y,
        linear-gradient(180deg, var(--background-color-lightblue) 0px, #fff 44rem);
      background-size: auto, auto 100%, auto 100%, auto;
    }

    .section-header h3 {
      font-size: 2rem;
    }

    .section-content .products-grid {
      grid-template-columns: 1fr;
    }

    .product-card {
      padding: 0 2rem 1.5rem;
    }

    .product-card:nth-child(n + 2) {
      position: relative;
      padding-top: 4rem;
      border-top: none;
    }

    .product-card:nth-child(n + 2)::after {
      content: "";
      height: 1px;
      width: 100%;
      background: linear-gradient(270deg, #ffffff 0%, #e3e3e3 51.39%, #ffffff 100%);
      position: absolute;
      top: 0;
      left: 0;
    }
  }
</style>
