---
import { fetchHomePage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const homePage = await fetchHomePage();

// Get localized values
const title1 = getLocalizedValue(homePage?.heroTitle1, lang) || 'A new leap begins';
const title2 = getLocalizedValue(homePage?.heroTitle2, lang) || 'from our new hub';

// Get image URL from Sanity or fallback to static
const heroImageUrl = homePage?.heroImage
  ? urlFor(homePage.heroImage).width(1920).quality(85).auto('format').url()
  : '/images/home/banner-2-2026.jpg';
---

<section class="home-banner">
  <div class="parallax-container">
    <div class="parallax-bg" style={`background-image: url('${heroImageUrl}')`}>
    </div>
    <div class="parallax-content">
      <div class="banner-text fade-in">
        <h2>{title1}</h2>
        <h1>{title2}</h1>
        <span class="header-line sort-line"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .home-banner {
    position: relative;
    width: 100%;
    padding: 0;
    overflow: hidden;
  }

  .parallax-container {
    position: relative;
    width: 100%;
    height: 47rem;
    overflow: hidden;
  }

  .parallax-bg {
    position: absolute;
    top: -9rem;
    left: 0;
    width: 100%;
    height: calc(100% + 18rem);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: translateZ(0);
    will-change: transform;
  }

  .parallax-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: white;
    text-align: center;
  }

  .banner-text {
    position: relative;
    top: -2rem;
    padding: 0 2rem;
  }

  .banner-text h2,
  .banner-text h1 {
    color: white;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.5);
    margin-bottom: 1.2rem;
    line-height: 1;
  }

  .banner-text h2 {
    font-size: 4.2rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .banner-text h1 {
    font-size: 4.2rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 2rem auto 1.5rem;
  }

  .fade-in {
    animation: fadeInUp 1s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .banner-text h2,
    .banner-text h1 {
      font-size: 2.9rem;
      line-height: 1.3;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .parallax-bg {
      animation: parallaxScroll linear;
      animation-timeline: scroll();
      animation-range: 0 47rem;
    }
  }

  @keyframes parallaxScroll {
    to {
      transform: translateY(15%);
    }
  }
</style>

<script>
  // Smooth parallax effect on scroll
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY;
      const parallaxBg = document.querySelector('.parallax-bg') as HTMLElement;
      if (parallaxBg && scrolled < window.innerHeight) {
        parallaxBg.style.transform = `translateY(${scrolled * 0.5}px)`;
      }
    });
  }
</script>
