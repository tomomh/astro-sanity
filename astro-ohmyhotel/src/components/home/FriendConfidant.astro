---
import { fetchHomePage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const homePage = await fetchHomePage();

// Get localized values with fallbacks
const title = getLocalizedValue(homePage?.friendTitle, lang);
const description = getLocalizedValue(homePage?.friendDescription, lang);

// Use Sanity data (content now fully managed in Sanity)
const displayHeader = getLocalizedValue(homePage?.friendHeader, lang) || '';
const displayQuote = title || '';

// Get slogans from Sanity
const slogans = homePage?.friendSlogans?.map((slogan: any) => ({
  icon: slogan.icon ? urlFor(slogan.icon).url() : '/images/home/society.svg',
  title: getLocalizedValue(slogan.title, lang) || '',
  content: getLocalizedValue(slogan.content, lang) || ''
})) || [];
---

<section class="your-friend-confidant-section">
  <div class="section-header align-center">
    {displayHeader && <h3 class="section-title">{displayHeader}</h3>}
    {displayQuote && <h4 class="quote"><span class="quote-mark open">"</span>{displayQuote}<span class="quote-mark close">"</span></h4>}
    <span class="header-line"></span>
  </div>
  <div class="container">
    <div class="section-content">
      <div class="slogans-grid">
        {slogans.map((slogan) => (
          <div class="slogan-card">
            <div class="item-icon">
              <img src={slogan.icon} alt={slogan.title} />
            </div>
            <h6 class="p-title">{slogan.title}</h6>
            <p>{slogan.content}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .your-friend-confidant-section {
    padding: 0 0 8rem;
    background-color: #ffffff;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .align-center {
    text-align: center;
  }

  .section-title {
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--primary-text-color);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .quote {
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--primary-header-color);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
    position: relative;
    display: inline-block;
  }

  .quote-mark {
    font-family: Georgia, serif;
    font-size: 4rem;
    font-weight: 400;
    color: #f5a623;
    line-height: 1;
    vertical-align: middle;
  }

  .quote-mark.open {
    margin-right: 0.5rem;
  }

  .quote-mark.close {
    margin-left: 0.5rem;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .slogans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .slogan-card {
    background: transparent;
    border: none;
    padding: 1.5rem;
    text-align: center;
  }

  .item-icon {
    margin-bottom: 1.5rem;
  }

  .item-icon img {
    width: 7.4rem;
    height: auto;
    object-fit: contain;
  }

  .p-title {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--primary-header-color);
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .slogan-card p {
    font-size: 1.4rem;
    color: var(--primary-text-color);
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 767px) {
    .your-friend-confidant-section {
      padding: 0 0 5rem;
    }

    .quote {
      font-size: 2rem;
    }

    .slogans-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .slogan-card {
      padding-bottom: 3rem;
    }

    .slogan-card:last-child {
      padding-bottom: 0;
    }
  }
</style>
