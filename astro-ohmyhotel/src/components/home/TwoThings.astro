---
import { fetchHomePage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const homePage = await fetchHomePage();

// Get localized values with fallbacks
const header = getLocalizedValue(homePage?.twoThingsTitle, lang);
const subtitle = getLocalizedValue(homePage?.twoThingsSubtitle, lang);

// Get items from Sanity or use fallback
const items = homePage?.twoThingsItems?.map((item: any) => ({
  title: getLocalizedValue(item.title, lang),
  description: getLocalizedValue(item.description, lang),
  image: item.image ? urlFor(item.image).width(400).auto('format').url() : null
})) || [];

// Use Sanity data (content now fully managed in Sanity)
const displayHeader = header || '';
const displayItems = items;
---

<section class="two-things-section">
  <div class="container">
    <div class="section-header fade-in">
      <h3 set:html={displayHeader}></h3>
      <span class="header-line"></span>
    </div>
    <div class="section-content">
      <div class="row">
        {displayItems.map((item: any, index: number) => (
          <div class="col">
            <img
              src={item.image || '/images/home/cost-reduction.svg'}
              alt={item.title}
              class={index === 0 ? 'cost-reduction-img' : ''}
            />
            <h5 class="p-title">{item.title}</h5>
            <div class="p-content" set:html={item.description}></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .two-things-section {
    padding: 5rem 0 9rem;
    background-color: var(--background-color-lightblue);
    position: relative;
    z-index: 3;
  }

  /* Hide section skew borders for this section */
  .two-things-section::before,
  .two-things-section::after {
    display: none;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    padding-bottom: 2rem;
  }

  .section-header h3 {
    font-size: 3rem;
    font-weight: 400;
    color: var(--primary-header-color);
    margin-bottom: 2rem;
    line-height: 1.3;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .section-content {
    text-align: center;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .col {
    text-align: center;
    padding: 0 1rem;
  }

  .col img {
    padding: 3.5rem 0 5rem;
    max-width: 100%;
    height: auto;
  }

  .cost-reduction-img {
    transform: translateX(12%);
  }

  .p-title {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--primary-header-color);
    margin-bottom: 1.5rem;
  }

  .p-content {
    font-size: 1.5rem;
    color: var(--primary-text-color);
    line-height: 1.8;
  }

  .fade-in {
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .two-things-section {
      padding: 5rem 0 4rem;
      overflow: hidden;
    }

    .section-header {
      padding-bottom: 0;
    }

    .section-header h3 {
      font-size: 2rem;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .col img {
      padding: 3.5rem 2rem 3.5rem;
    }

    .cost-reduction-img {
      transform: translateX(10%);
    }

    .p-title {
      font-size: 1.6rem;
    }

    .p-content {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 991px) and (min-width: 768px) {
    .col img {
      height: 25rem;
      padding: 2rem 0 4rem;
    }

    .p-content :global(br) {
      display: none;
    }
  }
</style>
