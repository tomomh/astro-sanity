---
import { fetchHomePage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const homePage = await fetchHomePage();

// Get localized values with fallbacks
const header = getLocalizedValue(homePage?.simpleTitle, lang);
const description = getLocalizedValue(homePage?.simpleDescription, lang);

// Get image from Sanity or fallback
const imageUrl = homePage?.simpleImage
  ? urlFor(homePage.simpleImage).width(828).quality(90).auto('format').url()
  : '/images/home/management-system.png';

// Use Sanity data (content now fully managed in Sanity)
const displayHeader = header || '';
const displayContent = description || '';
---

<section class="simple-intuitive-section">
  <div class="section-header align-center">
    <h3>{displayHeader}</h3>
    <span class="header-line"></span>
  </div>
  <div class="container">
    <div class="section-content">
      <p set:html={displayContent}></p>
      <div class="management-system">
        <picture>
          <source
            media="(max-width: 767.98px)"
            srcset={imageUrl}
          />
          <img
            src={imageUrl}
            width="828"
            alt="Management System"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .simple-intuitive-section {
    padding: 5rem 0 9rem;
    background-color: #fff;
  }

  .section-header {
    text-align: center;
    margin-bottom: 1rem;
  }

  .align-center {
    text-align: center;
  }

  .section-header h3 {
    font-size: 3rem;
    font-weight: 400;
    color: var(--primary-header-color);
    margin-bottom: 2rem;
    line-height: 1.3;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-content {
    text-align: center;
  }

  .section-content p {
    font-size: 1.5rem;
    color: var(--primary-text-color);
    line-height: 1.8;
    margin-bottom: 0;
  }

  .management-system {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0 2rem;
  }

  .management-system picture {
    max-width: 100%;
  }

  .management-system img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .simple-intuitive-section {
      padding: 4rem 0 2rem;
    }

    .section-header h3 {
      font-size: 2rem;
    }

    .section-content p {
      font-size: 1.4rem;
    }
  }
</style>
