---
import { fetchHomePage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const homePage = await fetchHomePage();

// Get localized values with fallbacks
const header = getLocalizedValue(homePage?.simpleTitle, lang);
const description = getLocalizedValue(homePage?.simpleDescription, lang);

// Get image from Sanity or fallback
const imageUrl = homePage?.simpleImage
  ? urlFor(homePage.simpleImage).width(828).quality(90).auto('format').url()
  : '/images/home/management-system.png';

// Fallback translations
const fallbackTranslations: Record<string, any> = {
  en: {
    header: "Simple and intuitive asset management system",
    content: "The most ideal system for selling as many rooms as possible. <br/>Enjoy all of these benefits with a strategic partnership."
  },
  ja: {
    header: "シンプルで直感的な資産管理システム",
    content: "できるだけ多くの部屋を販売するための最も理想的なシステム。<br/>戦略的パートナーシップでこれらのメリットをすべてお楽しみください。"
  },
  ko: {
    header: "간편하고 직관적인 자산 관리 시스템",
    content: "가능한 한 많은 객실을 판매하기 위한 가장 이상적인 시스템.<br/>전략적 파트너십으로 이 모든 혜택을 누리세요."
  },
  vi: {
    header: "Hệ thống quản lý tài sản đơn giản và trực quan",
    content: "Hệ thống lý tưởng nhất để bán càng nhiều phòng càng tốt. <br/>Tận hưởng tất cả những lợi ích này với quan hệ đối tác chiến lược."
  }
};

const t = fallbackTranslations[lang] || fallbackTranslations.en;

// Use Sanity data or fallback
const displayHeader = header || t.header;
const displayContent = description || t.content;
---

<section class="simple-intuitive-section">
  <div class="section-header align-center">
    <h3>{displayHeader}</h3>
    <span class="header-line"></span>
  </div>
  <div class="container">
    <div class="section-content">
      <p set:html={displayContent}></p>
      <div class="management-system">
        <picture>
          <source
            media="(max-width: 767.98px)"
            srcset={imageUrl}
          />
          <img
            src={imageUrl}
            width="828"
            alt="Management System"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .simple-intuitive-section {
    padding: 5rem 0 9rem;
    background-color: #fff;
  }

  .section-header {
    text-align: center;
    margin-bottom: 1rem;
  }

  .align-center {
    text-align: center;
  }

  .section-header h3 {
    font-size: 3rem;
    font-weight: 400;
    color: var(--primary-header-color);
    margin-bottom: 2rem;
    line-height: 1.3;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-content {
    text-align: center;
  }

  .section-content p {
    font-size: 1.5rem;
    color: var(--primary-text-color);
    line-height: 1.8;
    margin-bottom: 0;
  }

  .management-system {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0 2rem;
  }

  .management-system picture {
    max-width: 100%;
  }

  .management-system img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .simple-intuitive-section {
      padding: 4rem 0 2rem;
    }

    .section-header h3 {
      font-size: 2rem;
    }

    .section-content p {
      font-size: 1.4rem;
    }
  }
</style>
