---
import { fetchJobListings, fetchCareersPage } from '../../utils/queries';
import { getLocalizedValue } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const careersPage = await fetchCareersPage();
const jobListings = await fetchJobListings();

// Get localized values from Sanity
const sanityHeader = getLocalizedValue(careersPage?.jobOpportunitiesTitle, lang);

// Map Sanity job listings to display format
const sanityJobs = jobListings?.map((job: any) => ({
  department: getLocalizedValue(job.department, lang) || job.department,
  title: getLocalizedValue(job.title, lang) || job.title,
  flag: job.locationFlag || '/images/flags/international.png',
  links: job.links || []
})) || [];

