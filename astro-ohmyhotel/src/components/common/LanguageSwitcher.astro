---
export interface Props {
  currentLang: string;
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;

// Language options
const languages = [
  { code: 'ja', name: 'Japanese', localName: '日本語' },
  { code: 'en', name: 'English', localName: 'English' },
  { code: 'vi', name: 'Vietnamese', localName: 'Tiếng Việt' },
  { code: 'ko', name: 'Korean', localName: '한국어' }
];

// Translation labels
const translations: Record<string, Record<string, string>> = {
  ja: {
    langJa: '日本語',
    langEn: 'English',
    langVi: 'Tiếng Việt',
    langKo: '한국어'
  },
  en: {
    langJa: 'Japanese',
    langEn: 'English',
    langVi: 'Vietnamese',
    langKo: 'Korean'
  },
  vi: {
    langJa: 'Tiếng Nhật',
    langEn: 'Tiếng Anh',
    langVi: 'Tiếng Việt',
    langKo: 'Tiếng Hàn'
  },
  ko: {
    langJa: '일본어',
    langEn: '영어',
    langVi: '베트남어',
    langKo: '한국어'
  }
};

const t = translations[currentLang] || translations.en;

// Function to get language link
const getLanguageLink = (langCode: string) => {
  // Remove current language from path if it exists
  const pathWithoutLang = currentPath.replace(/^\/(ja|en|vi|ko)/, '');
  // Add new language prefix
  return langCode === 'ja' ? (pathWithoutLang || '/') : `/${langCode}${pathWithoutLang || ''}`;
};

const currentLangName = `lang${currentLang.charAt(0).toUpperCase()}${currentLang.slice(1)}`;
---

<div class="language-switcher dropdown" data-dropdown="lang">
  <button class="nav-link dropdown-toggle no-underline" aria-expanded="false" type="button">
    <span class="lang-flag">
      <img src={`/images/flags/${currentLang}.svg`} alt={currentLang} />
    </span>
    <span>{t[currentLangName]}</span>
  </button>
  <div class="dropdown-menu">
    {languages.map((lang) => (
      <a href={getLanguageLink(lang.code)} class="lang-option no-underline">
        <span class="lang-flag">
          <img src={`/images/flags/${lang.code}.svg`} alt={lang.name} />
        </span>
        <span>{t[`lang${lang.code.charAt(0).toUpperCase()}${lang.code.slice(1)}`]}</span>
      </a>
    ))}
  </div>
</div>

<style>
  .language-switcher {
    position: relative;
  }

  .language-switcher .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0;
    cursor: pointer;
    background: none;
    border: none;
    font-size: 1.4rem;
    color: #555;
  }

  .language-switcher .nav-link:hover {
    color: black;
  }

  .lang-flag {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 0.8rem;
  }

  .lang-flag img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .language-switcher .dropdown-menu {
    display: none;
    position: absolute;
    right: 0;
    top: 100%;
    width: 17rem;
    font-family: "Noto Sans", sans-serif;
    padding: 2rem 0;
    box-shadow: 0 -1px 9px 0 rgba(0, 0, 0, 0.2);
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 7px;
    margin-top: 1rem;
    z-index: 10;
  }

  .language-switcher:hover .dropdown-menu,
  .language-switcher.show .dropdown-menu {
    display: block;
  }

  .lang-option {
    padding: 0.8rem 2.8rem;
    color: #555;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    cursor: pointer;
    position: relative;
  }

  .lang-option::after {
    content: "";
    display: block;
    position: absolute;
    left: 0;
    width: 0;
    height: 2.3rem;
    background: var(--brand-color-gradient);
    top: 0.8rem;
    transition: 0.15s width 0.1s cubic-bezier(0.39, 0.575, 0.565, 1);
    box-shadow: var(--primary-box-shadow);
  }

  .lang-option:hover {
    color: black;
    text-decoration: none;
  }

  .lang-option:hover::after {
    width: 0.3rem;
  }

  @media only screen and (max-width: 767px) {
    .language-switcher .dropdown-menu .lang-option {
      justify-content: left;
      margin-left: 8%;
    }
  }
</style>

<script>
  // Dropdown toggle for language switcher
  const langSwitcher = document.querySelector('.language-switcher');
  const langToggle = langSwitcher?.querySelector('.dropdown-toggle');
  const langMenu = langSwitcher?.querySelector('.dropdown-menu');

  let isMouseOver = false;

  function openDropdown() {
    if (window.innerWidth > 767) {
      langSwitcher?.classList.add('show');
      langToggle?.setAttribute('aria-expanded', 'true');
    }
  }

  function closeDropdown() {
    if (window.innerWidth > 767 && !isMouseOver) {
      langSwitcher?.classList.remove('show');
      langToggle?.setAttribute('aria-expanded', 'false');
    }
  }

  langSwitcher?.addEventListener('mouseenter', () => {
    isMouseOver = true;
    openDropdown();
  });

  langSwitcher?.addEventListener('mouseleave', () => {
    isMouseOver = false;
    setTimeout(closeDropdown, 100);
  });

  langToggle?.addEventListener('click', (e) => {
    if (window.innerWidth <= 767) {
      e.preventDefault();
      const isExpanded = langToggle.getAttribute('aria-expanded') === 'true';
      langSwitcher?.classList.toggle('show');
      langToggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    }
  });
</script>
