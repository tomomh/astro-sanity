---
import LanguageSwitcher from '../common/LanguageSwitcher.astro';
import { fetchSiteSettings } from '../../utils/queries';
import { getLocalizedValue } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  currentLang: string;
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;
const lang = currentLang as Language;

// Fetch site settings from Sanity
const siteSettings = await fetchSiteSettings();

const getPageActive = () => {
  const segments = currentPath.split('/').filter(Boolean);
  return segments.length > 0 ? segments[0] : '';
};

const pageActive = getPageActive();

// Navigation menu structure
const navigation = {
  aboutUs: {
    id: 'about-us',
    items: [
      { href: '/about-us/ceo-message', labelKey: 'ceoMessage' },
      { href: '/about-us/vision', labelKey: 'vision' },
      { href: '/about-us/history', labelKey: 'history' },
      { href: '/about-us/ci', labelKey: 'ci' },
      { href: '/about-us/location', labelKey: 'location' }
    ]
  },
  business: {
    id: 'business',
    items: [
      { href: '/business/online-booking-engine', labelKey: 'ota' },
      { href: '/business/hotel-web', labelKey: 'bookingEngine' },
      { href: '/business/pms', labelKey: 'pms' },
      { href: '/business/cms', labelKey: 'cms' },
      { href: '/business/company-profile', labelKey: 'hotelManagement' }
    ]
  },
  careers: {
    id: 'careers',
    items: [
      { href: '/careers/desired-traits', labelKey: 'desiredTraits' },
      { href: '/careers/job-opportunities', labelKey: 'jobOpportunities' }
    ]
  }
};

// Fallback translations for submenu items (not in Sanity yet)
const fallbackTranslations: Record<string, Record<string, string>> = {
  ja: {
    home: 'ホーム',
    aboutUs: '会社紹介',
    business: '事業内容',
    careers: '採用情報',
    ceoMessage: 'CEO挨拶',
    vision: 'ビジョン',
    history: '沿革',
    ci: 'CI',
    location: '所在地',
    ota: 'OTA',
    bookingEngine: '予約エンジン',
    pms: 'PMS',
    cms: 'CMS',
    hotelManagement: 'ホテル経営',
    desiredTraits: '求める人材',
    jobOpportunities: '採用情報'
  },
  en: {
    home: 'Home',
    aboutUs: 'About Us',
    business: 'Business',
    careers: 'Careers',
    ceoMessage: 'CEO Message',
    vision: 'Vision',
    history: 'History',
    ci: 'CI',
    location: 'Location',
    ota: 'OTA',
    bookingEngine: 'Booking Engine',
    pms: 'PMS',
    cms: 'CMS',
    hotelManagement: 'Hotel Management',
    desiredTraits: 'Desired Traits',
    jobOpportunities: 'Job Opportunities'
  },
  vi: {
    home: 'Trang chủ',
    aboutUs: 'Giới thiệu công ty',
    business: 'Lĩnh vực kinh doanh',
    careers: 'Tuyển dụng',
    ceoMessage: 'Thông điệp CEO',
    vision: 'Tầm nhìn',
    history: 'Lịch sử',
    ci: 'CI',
    location: 'Vị trí',
    ota: 'OTA',
    bookingEngine: 'Công cụ đặt phòng',
    pms: 'PMS',
    cms: 'CMS',
    hotelManagement: 'Quản lý khách sạn',
    desiredTraits: 'Phẩm chất mong muốn',
    jobOpportunities: 'Cơ hội việc làm'
  },
  ko: {
    home: '홈',
    aboutUs: '회사소개',
    business: '사업소개',
    careers: '채용정보',
    ceoMessage: 'CEO 인사말',
    vision: '비전',
    history: '연혁',
    ci: 'CI',
    location: '오시는 길',
    ota: 'OTA',
    bookingEngine: '예약엔진',
    pms: 'PMS',
    cms: 'CMS',
    hotelManagement: '호텔경영',
    desiredTraits: '인재상',
    jobOpportunities: '채용공고'
  }
};

const fallback = fallbackTranslations[currentLang] || fallbackTranslations.en;

// Use Sanity data for main nav labels, fallback for submenu items
const t = {
  ...fallback,
  // Main nav labels from Sanity
  aboutUs: getLocalizedValue(siteSettings?.footerLinks?.aboutUs, lang) || fallback.aboutUs,
  business: getLocalizedValue(siteSettings?.footerLinks?.business, lang) || fallback.business,
  careers: getLocalizedValue(siteSettings?.footerLinks?.careers, lang) || fallback.careers,
};
---

<header class="app-header">
  <nav class="navbar container">
    <a href="/" class="navbar-brand no-underline">
      <img src="/images/logo/logo.svg" alt="Ohmyhotel & CO" height="34" />
    </a>

    <button class="navbar-toggler" id="navbarToggler" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="navbar-collapse" id="navbarCollapse">
      <button class="close-collapse-nav" id="closeNav" aria-label="Close navigation">
        <img src="/images/icons/close.svg" alt="Close" height="20" />
      </button>

      <ul class="navbar-nav">
        <!-- About Us Dropdown -->
        <li class={`nav-item dropdown ${pageActive === 'about-us' ? 'active' : ''}`} data-dropdown="about">
          <a href="#" class="nav-link dropdown-toggle no-underline" aria-expanded="false">
            {t.aboutUs}
          </a>
          <span class="header-line sort-line"></span>
          <div class="dropdown-menu">
            {navigation.aboutUs.items.map((item) => (
              <a href={item.href} class="nav-link no-underline">{t[item.labelKey]}</a>
            ))}
          </div>
        </li>

        <!-- Business Dropdown -->
        <li class={`nav-item dropdown ${pageActive === 'business' ? 'active' : ''}`} data-dropdown="business">
          <a href="#" class="nav-link dropdown-toggle no-underline" aria-expanded="false">
            {t.business}
          </a>
          <span class="header-line sort-line"></span>
          <div class="dropdown-menu">
            {navigation.business.items.map((item) => (
              <a href={item.href} class="nav-link no-underline">{t[item.labelKey]}</a>
            ))}
          </div>
        </li>

        <!-- Careers Dropdown -->
        <li class={`nav-item dropdown ${pageActive === 'careers' ? 'active' : ''}`} data-dropdown="careers">
          <a href="#" class="nav-link dropdown-toggle no-underline" aria-expanded="false">
            {t.careers}
          </a>
          <span class="header-line sort-line"></span>
          <div class="dropdown-menu">
            {navigation.careers.items.map((item) => (
              <a href={item.href} class="nav-link no-underline">{t[item.labelKey]}</a>
            ))}
          </div>
        </li>

        <!-- Language Switcher -->
        <li class="nav-item languages">
          <LanguageSwitcher currentLang={currentLang} currentPath={currentPath} />
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .app-header {
    background-color: white;
    position: fixed;
    top: 0;
    width: 100vw;
    border-bottom: var(--primary-border);
    z-index: 5;
  }

  .navbar {
    padding: 0 1.5rem;
    color: var(--primary-text-color);
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .navbar-brand {
    padding: 0.55rem 0;
  }

  .navbar-toggler {
    display: none;
    border: none;
    padding: 2.9rem 0 2.9rem 1.5rem;
    cursor: pointer;
    background-color: white;
    border-radius: 0;
  }

  .navbar-toggler:focus {
    outline: none;
    box-shadow: none;
  }

  .navbar-toggler-icon {
    background-image: none;
    height: 0;
    border-bottom: 0.2rem solid #4e4e4e;
    display: block;
    margin-left: auto;
    border-radius: 0.1rem;
    width: 1.3rem;
    position: relative;
  }

  .navbar-toggler-icon::before,
  .navbar-toggler-icon::after {
    position: absolute;
    content: "";
    height: 0;
    border-bottom: 0.2rem solid #4e4e4e;
    display: block;
    border-radius: 0.1rem;
    right: 0;
  }

  .navbar-toggler-icon::after {
    width: 1.9rem;
    margin-bottom: 0;
    bottom: -0.8rem;
  }

  .navbar-toggler-icon::before {
    top: -0.6rem;
    width: 1.6rem;
  }

  .close-collapse-nav {
    display: none;
  }

  .navbar-collapse {
    display: flex;
    align-items: center;
  }

  .navbar-nav {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-item {
    margin: 0;
    padding: 2.55rem 1.8rem;
    position: relative;
  }

  .nav-link {
    padding: 0.2rem 0;
    text-transform: uppercase;
    color: #555;
    font-size: 1.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .dropdown-toggle::after {
    content: "";
    margin-left: 0.5rem;
    border-top: 0.4rem solid;
    border-right: 0.3rem solid transparent;
    border-left: 0.3rem solid transparent;
    border-top-color: #666;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: black;
  }

  .nav-item.active .nav-link {
    font-weight: bold;
  }

  .header-line {
    display: none;
    max-width: 100%;
  }

  .nav-item.active .header-line {
    display: flex;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    color: #555;
    font-size: 1.4rem;
    cursor: pointer;
    width: 25.4rem;
    transform: translateX(50%);
    margin-right: 50%;
    padding: 2rem 0;
    box-shadow: 0 -1px 9px 0 rgba(0, 0, 0, 0.2);
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 7px;
    border: none;
    margin-top: -0.5px;
    top: 100%;
    left: 50%;
  }

  .dropdown-menu::before {
    position: absolute;
    display: block;
    content: "";
    border-color: transparent;
    border-style: solid;
    top: -0.8rem;
    left: calc(50% - 0.8rem);
    border-color: transparent transparent rgba(255, 255, 255, 0.94) rgba(255, 255, 255, 0.94);
    border-width: 0.8rem;
    box-shadow: -3px 3px 6px 0 rgba(0, 0, 0, 0.1);
    transform: rotate(135deg);
  }

  .dropdown:hover .dropdown-menu,
  .dropdown.show .dropdown-menu {
    display: block;
  }

  .dropdown-menu .nav-link {
    padding: 0.8rem 2.8rem;
    color: #555;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    text-transform: none;
    position: relative;
  }

  .dropdown-menu .nav-link::after {
    content: "";
    display: block;
    position: absolute;
    left: 0;
    width: 0;
    height: 2.3rem;
    background: var(--brand-color-gradient);
    top: 0.8rem;
    transition: 0.15s width 0.1s cubic-bezier(0.39, 0.575, 0.565, 1);
    transform: none;
    box-shadow: var(--primary-box-shadow);
    border: none;
  }

  .dropdown-menu .nav-link:hover::after {
    width: 0.3rem;
  }

  .nav-item.languages {
    padding: 2.3rem 0 2.4rem 3.6rem;
    position: relative;
    display: flex;
  }

  .nav-item.languages::before {
    content: "";
    height: 1rem;
    width: 0.1rem;
    background-color: #ccc;
    position: absolute;
    left: 0;
    top: 3.5rem;
  }

  /* Mobile Styles */
  @media only screen and (max-width: 767px) {
    .navbar-toggler {
      display: block;
    }

    .navbar.container {
      padding: 0 2rem;
    }

    .navbar-brand img {
      height: 3rem !important;
    }

    .navbar-collapse {
      background-color: rgba(255, 255, 255, 0.98);
      transition: height 0.35s ease;
      position: fixed;
      max-height: 0;
      height: 0;
      width: 100vw;
      top: 0;
      left: 0;
      overflow: hidden;
      flex-direction: column;
      align-items: stretch;
    }

    .navbar-collapse.show {
      max-height: 100vh;
      height: 100vh;
    }

    .close-collapse-nav {
      display: flex;
      justify-content: flex-end;
      padding: 1.6rem 3rem;
      background: transparent;
      border: none;
      cursor: pointer;
    }

    .navbar-nav {
      flex-direction: column;
      height: calc(100vh - 6.1rem);
      margin: auto;
      padding-top: 3rem;
      overflow: auto;
      width: 100%;
    }

    .nav-item {
      width: 100%;
      padding-bottom: 0;
      text-align: center;
    }

    .nav-item::after {
      content: "";
      height: 1px;
      width: 100%;
      background: linear-gradient(270deg, #ffffff 0%, #e3e3e3 51.39%, #ffffff 100%);
      margin-top: 2.55rem;
      display: block;
    }

    .nav-item:not(.languages) .dropdown-toggle::after {
      border: none;
      background-image: url("/images/icons/chevron.svg");
      height: 2.2rem;
      width: 1.2rem;
      background-repeat: no-repeat;
      background-size: contain;
      transform: rotate(90deg);
      vertical-align: middle;
      margin: 0;
      margin-left: 1.5rem;
      transition: transform 0.3s ease-in-out;
    }

    .nav-item:not(.languages) .dropdown-toggle[aria-expanded="true"]::after {
      transform: rotate(-90deg);
    }

    .nav-item .nav-link {
      font-size: 2.2rem;
      text-transform: unset;
      justify-content: center;
    }

    .dropdown-menu {
      position: static;
      background: transparent;
      box-shadow: none;
      transform: none;
      margin: 0;
      width: 100%;
      padding: 0;
      display: block;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.3s linear, opacity 0.3s linear;
    }

    .dropdown-menu::before {
      display: none;
    }

    .dropdown.show .dropdown-menu {
      max-height: 100vh;
      opacity: 1;
    }

    .nav-item.languages {
      width: 25rem;
      margin: 0 auto;
      padding: 2.55rem 1.8rem;
    }

    .nav-item.languages::before,
    .nav-item.languages::after {
      display: none;
    }

    .header-line {
      display: none;
    }
  }

  @media only screen and (min-width: 992px) {
    .app-header {
      padding-right: 1.7rem;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const navbarToggler = document.getElementById('navbarToggler');
  const navbarCollapse = document.getElementById('navbarCollapse');
  const closeNav = document.getElementById('closeNav');

  function openNav() {
    navbarCollapse?.classList.add('show');
    document.body.classList.add('disable-scroll');
  }

  function closeNavMenu() {
    navbarCollapse?.classList.remove('show');
    document.body.classList.remove('disable-scroll');
  }

  navbarToggler?.addEventListener('click', openNav);
  closeNav?.addEventListener('click', closeNavMenu);

  // Dropdown toggles for mobile
  const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
  dropdownToggles.forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      if (window.innerWidth <= 767) {
        e.preventDefault();
        const dropdown = toggle.closest('.dropdown');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        // Close all other dropdowns
        document.querySelectorAll('.dropdown').forEach(d => {
          if (d !== dropdown) {
            d.classList.remove('show');
            d.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle current dropdown
        dropdown?.classList.toggle('show');
        toggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      }
    });
  });

  // Close dropdown when clicking on a link
  const dropdownLinks = document.querySelectorAll('.dropdown-menu .nav-link');
  dropdownLinks.forEach(link => {
    link.addEventListener('click', closeNavMenu);
  });
</script>
