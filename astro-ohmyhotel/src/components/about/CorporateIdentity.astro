---
import { fetchAboutUsPage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const aboutPage = await fetchAboutUsPage();
const corporateIdentity = aboutPage?.corporateIdentity;

// Get localized values from Sanity
const introTitle = getLocalizedValue(corporateIdentity?.introTitle, lang);
const introText = getLocalizedValue(corporateIdentity?.intro, lang);
const colorSystemDesc = getLocalizedValue(corporateIdentity?.colorSystem?.description, lang);
const signatureDesc = getLocalizedValue(corporateIdentity?.signatureDescription, lang);

// Get intro images from Sanity
const introImages = corporateIdentity?.introImages;
const mainLogoUrl = introImages?.mainLogo ? urlFor(introImages.mainLogo).url() : '/images/about/ci-intro-logo-new.svg';
const secondaryLogoUrl = introImages?.secondaryLogo ? urlFor(introImages.secondaryLogo).url() : '/images/about/ci-intro-logo-new-1.svg';
const aiDownloadUrl = introImages?.aiDownloadUrl || '/images/about/ci_ohmyhotelco_ai_new.zip';
const jpgDownloadUrl = introImages?.jpgDownloadUrl || '/images/about/ci_ohmyhotelco_new.zip';

// Get colors from Sanity with fallback
const sanityColors = corporateIdentity?.colorSystem?.colors || [];

// Map Sanity colors to display format
const colorsFromSanity = sanityColors.map((color: any) => ({
  name: color.name || '',
  type: color.type || 'solid',
  hex: color.hex || '',
  rgb: color.rgb || '',
  cmyk: color.cmyk || '',
  pantone: color.pantone || '',
  gradientColors: color.gradientColors || ''
}));

// Fallback colors
const fallbackColors = [
  { name: 'Orange Gradient', type: 'gradient', gradientColors: 'linear-gradient(90deg, #BD1819 0%, #F1C400 100%)' },
  { name: 'Green Gradient', type: 'gradient', gradientColors: 'linear-gradient(90deg, #07834C 0%, #1DA136 100%)' },
  { name: 'Orange', type: 'solid', hex: '#ff6000', rgb: '255/96/0', cmyk: '00/77/100/00' },
  { name: 'Black', type: 'solid', hex: '#383838', rgb: '56/56/56', cmyk: '69/62/61/54' },
  { name: 'White', type: 'solid', hex: '#fffcf8', rgb: '252/252/248', cmyk: '0/1/2/0' },
  { name: 'Green', type: 'solid', hex: '#00953a', rgb: '00/149/58', cmyk: '98/12/100/02' }
];

const colors = colorsFromSanity.length > 0 ? colorsFromSanity : fallbackColors;

// Get signatures from Sanity with fallback
const sanitySignatures = corporateIdentity?.signatures || [];

// Map Sanity signatures to display format
const signaturesFromSanity = sanitySignatures.map((sig: any) => ({
  backgroundColor: sig.backgroundColor || 'cream',
  image1: sig.image1 ? urlFor(sig.image1).url() : null,
  image2: sig.image2 ? urlFor(sig.image2).url() : null
}));

// Fallback signatures
const fallbackSignatures = [
  { backgroundColor: 'white', image1: '/images/about/ci-1-01.png', image2: '/images/about/ci-1-02.png' },
  { backgroundColor: 'cream', image1: '/images/about/ci-1-01.png', image2: '/images/about/ci-1-02.png' },
  { backgroundColor: 'orange', image1: '/images/about/ci-2-01.png', image2: '/images/about/ci-2-02.png' },
  { backgroundColor: 'cream', image1: '/images/about/ci-3-01.png', image2: '/images/about/ci-3-02.png' }
];

const signatures = signaturesFromSanity.length > 0 ? signaturesFromSanity : fallbackSignatures;

// Fallback content
const fallbackIntroTitle = 'Loved and Reliable Company <br/><img src="/images/logo/name-black.svg" alt="Ohmyhotel & Co">';

const fallbackIntro = `CI of Ohmyhotel & Co is the design which expresses creative ideas and active thinking method in a visual language.<br />
    CI also symbolizes the symbol mark of orange with a pleasant scent.<br />
    CI is the symbol of customer-centered management communicating with partners anytime and anywhere.`;

const fallbackColorDesc = `Ohmyhotel & Co colors are a key factor in establishing corporate identity.<br />
  For effective use, the designated colors should be used in accordance to the characteristics of the medium.<br />
  Upon significant differences in brightness, chroma or other aspects, the color should be as close to pantone color as possible.`;

const fallbackSignatureDesc = `Signature is the most reasonable and organized combination of the basic symbols and logos – in other words, it is a formal representation of the company.<br />
  This is the most straightforward method of representing the company's image. Thus, it is finetuned to accordance to the balance of each element.<br />
  Therefore, it should only be used in its specified perimeters.`;

// Use Sanity data or fallback
const displayIntroTitle = introTitle || fallbackIntroTitle;
const displayIntro = introText || fallbackIntro;
const displayColorDesc = colorSystemDesc || fallbackColorDesc;
const displaySignatureDesc = signatureDesc || fallbackSignatureDesc;

// Helper function to get CSS class for color type
const getColorClass = (color: any) => {
  if (color.type === 'gradient') {
    if (color.name?.toLowerCase().includes('orange')) return 'orange-gradient';
    if (color.name?.toLowerCase().includes('green')) return 'green-gradient';
    return 'gradient';
  }
  if (color.hex === '#ff6000') return 'orange';
  if (color.hex === '#383838') return 'black';
  if (color.hex === '#fffcf8') return 'white';
  if (color.hex?.toLowerCase().includes('00953a') || color.hex?.toLowerCase().includes('009538')) return 'green';
  return '';
};
---

<div class="CI-page">
  <!-- CI Intro Section -->
  <section class="ci-intro-section">
    <div class="section-header container">
      <h3>CI</h3>
      <span class="header-line"></span>
    </div>
    <div class="section-content">
      <div class="container">
        <h6 class="p-title" set:html={displayIntroTitle} />
        <p set:html={displayIntro} />
      </div>
      <div class="full-width-image">
        <img class="left" src={mainLogoUrl} alt="CI Logo" />
        <img class="right" src={secondaryLogoUrl} alt="CI Logo" />
      </div>
      <div class="content-center">
        <a href={aiDownloadUrl} download="ci_ohmyhotelco_ai" class="btn btn-primary">
          <img src="/images/about/download.svg" alt="" width="18" />
          <span>AI Download</span>
        </a>
        <a href={jpgDownloadUrl} download="ci_ohmyhotelco" class="btn btn-primary">
          <img src="/images/about/download.svg" alt="" width="18" />
          <span>JPG Download</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Color System Section -->
  <section class="color-system-section">
    <div class="section-header container">
      <h3>Color System</h3>
      <span class="header-line"></span>
    </div>
    <div class="section-content">
      <div class="container">
        <p set:html={displayColorDesc} />
        <div class="title-comp">
          <div>Ohmyhotel & Co</div>
          <div>Corporate Identity Basic System</div>
        </div>
        <div class="content-center row">
          {colors.map((color: any) => (
            <div class="color-item">
              <div
                class:list={["color-cycle", getColorClass(color)]}
                style={color.type === 'gradient' && color.gradientColors ? `background: ${color.gradientColors}` : (color.hex && !getColorClass(color) ? `background-color: ${color.hex}` : '')}
              ></div>
              <div class:list={[{ 'orange-gradient': color.name?.toLowerCase().includes('orange') && color.type === 'gradient', 'green-gradient': color.name?.toLowerCase().includes('green') && color.type === 'gradient' }]}>
                {color.type === 'gradient' ? (
                  <>
                    <p>Reference</p>
                    <p>Gradient View</p>
                  </>
                ) : (
                  <>
                    {color.cmyk && <p>CMYK: {color.cmyk}</p>}
                    {color.rgb && <p>RGB: {color.rgb}</p>}
                    {color.hex && <p>{color.hex}</p>}
                  </>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Corporate Signature Section -->
  <section class="corporate-signature-section">
    <div class="section-header container">
      <h3>Corporate Signature</h3>
      <span class="header-line"></span>
    </div>
    <div class="section-content">
      <div class="container">
        <p set:html={displaySignatureDesc} />
      </div>
      <div class="container signature-grid">
        <div class="signature-row">
          {signatures.map((sig: any) => (
            <div class="color-item-signature">
              <div class:list={[sig.backgroundColor]}>
                {sig.image1 && <img src={sig.image1} alt="Logo" />}
              </div>
              <div class:list={[sig.backgroundColor]}>
                {sig.image2 && <img src={sig.image2} alt="Logo" />}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .CI-page {
    background-color: #fff;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-top: 5rem;
  }

  .section-header h3 {
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--primary-header-color);
    margin-bottom: 1.5rem;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .section-content {
    text-align: center;
  }

  .section-content p {
    font-size: 1.4rem;
    color: var(--primary-text-color);
    line-height: 2.3rem;
    margin-bottom: 2rem;
  }

  /* CI Intro Section */
  .ci-intro-section .p-title {
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--primary-header-color);
    margin-bottom: 2rem;
  }

  .ci-intro-section .section-content .container {
    margin-top: 1rem;
  }

  .ci-intro-section .section-content p {
    margin-top: 4rem;
  }

  .ci-intro-section .full-width-image {
    background: url('/images/about/ci-intro-bg.svg') top center repeat;
    background-size: 606px auto;
    height: 25.7rem;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 3.5rem 0 4rem;
  }

  .ci-intro-section .full-width-image img.left {
    height: 25.7rem;
  }

  .ci-intro-section .full-width-image img.right {
    height: 7rem;
  }

  .content-center {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem;
    margin: 0 1.3rem;
    background: var(--brand-color-gradient);
    color: #fff;
    border: none;
    border-radius: 0.5rem;
    font-size: 1.4rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .btn img {
    filter: brightness(0) invert(1);
  }

  /* Color System Section */
  .color-system-section {
    padding-bottom: 4rem;
  }

  .color-system-section .row {
    max-width: 72rem;
    margin: 2rem auto;
    display: flex;
    justify-content: center;
  }

  .title-comp {
    text-align: left;
    padding: 1.5rem 0.9rem 2rem;
    color: #ABACAE;
    position: relative;
    max-width: 72rem;
    margin: 2rem auto;
  }

  .title-comp::after {
    content: "";
    width: 13%;
    height: 2px;
    background: #ABACAE;
    position: absolute;
    bottom: 10px;
    left: 10px;
  }

  .title-comp::before {
    content: "";
    width: 13%;
    height: 2px;
    background: #ABACAE;
    position: absolute;
    top: 8px;
    left: 10px;
  }

  .color-item {
    padding: 1.5rem 0.9rem 2rem;
    width: 18rem;
    text-align: center;
  }

  .color-item .orange-gradient {
    color: #EE7E28;
  }

  .color-item .green-gradient {
    color: #07834C;
  }

  .color-item p {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.8;
  }

  .color-cycle {
    height: 10rem;
    width: 10rem;
    border-radius: 50%;
    box-shadow: 0 2px 10px 0 rgba(0, 0, 0, 0.15);
    border: 1rem solid white;
    margin: 0 auto 1.6rem;
  }

  .color-cycle.orange-gradient {
    background: linear-gradient(90deg, #BD1819 0%, #F1C400 100%);
  }

  .color-cycle.green-gradient {
    background: linear-gradient(90deg, #07834C 0%, #1DA136 100%);
  }

  .color-cycle.orange {
    background-color: #ff6000;
  }

  .color-cycle.black {
    background-color: #383838;
  }

  .color-cycle.white {
    background-color: #fffcf8;
  }

  .color-cycle.green {
    background-color: rgb(0, 149, 58);
  }

  /* Corporate Signature Section */
  .corporate-signature-section {
    padding-bottom: 6rem;
  }

  .corporate-signature-section .section-content .container {
    margin-bottom: 5rem;
  }

  .signature-grid {
    margin-bottom: 2rem;
  }

  .signature-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .color-item-signature {
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .color-item-signature > div {
    background-color: #fffcf8;
    border: 1px solid #C2C2C0;
    padding: 2rem;
  }

  .color-item-signature > div.white {
    background-color: #FFFFFF;
  }

  .color-item-signature > div.cream {
    background-color: #fffcf8;
  }

  .color-item-signature > div.orange {
    background-color: #ff6000;
  }

  .color-item-signature img {
    max-width: 100%;
    height: auto;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .section-header {
      padding-top: 4rem;
    }

    .section-header h3 {
      font-size: 2rem;
    }

    .ci-intro-section .full-width-image {
      height: 14.8rem;
      background-size: 90% 75%, auto;
      flex-direction: column;
    }

    .ci-intro-section .full-width-image img.left {
      height: 14.8rem;
    }

    .ci-intro-section .full-width-image img.right {
      height: 4rem;
    }

    .btn {
      flex-direction: column;
      margin: 0.5rem;
    }

    .btn img {
      margin-bottom: 0.5rem;
    }

    .color-system-section .row {
      max-width: 36rem;
    }

    .color-item {
      width: 50%;
    }

    .signature-row {
      flex-direction: column;
    }

    .color-item-signature {
      flex-direction: row;
    }
  }
</style>
