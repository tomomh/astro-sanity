---
import { fetchAboutUsPage } from '../../utils/queries';
import { getLocalizedValue, urlFor } from '../../utils/sanity';
import type { Language } from '../../utils/i18n';
import { PortableText } from 'astro-portabletext';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Fetch data from Sanity
const aboutPage = await fetchAboutUsPage();
const ceoMessage = aboutPage?.ceoMessage;

// Get localized values with fallbacks
const header = getLocalizedValue(ceoMessage?.title, lang) || 'CEO Message';
const content = getLocalizedValue(ceoMessage?.content, lang);
const ceoTitle = getLocalizedValue(ceoMessage?.ceoTitle, lang) || 'CEO';
const ceoName = ceoMessage?.ceoName || 'Jackie Lee';

// Get images from Sanity or fallback to static
const ceoImageUrl = ceoMessage?.ceoImage
  ? urlFor(ceoMessage.ceoImage).width(400).quality(90).auto('format').url()
  : '/images/about/img-ceo-2026.png';

const signatureUrl = ceoMessage?.ceoSignature
  ? urlFor(ceoMessage.ceoSignature).width(200).auto('format').url()
  : '/images/about/sign.svg';

// Use Sanity data (content now fully managed in Sanity)
const greeting = getLocalizedValue(ceoMessage?.greeting, lang) || '';
---

<section class="ceo-section">
  <div class="container">
    <div class="section-header">
      <h3>{header}</h3>
      <span class="header-line"></span>
    </div>
    <div class="section-content align-left">
      <div class="ceo-message-content">
        <h4 class="quote">{greeting}</h4>
        {content && (
          <div class="message-text">
            <PortableText value={content} />
          </div>
        )}
        <div class="ceo-signature">
          <span>{ceoTitle} {ceoName}</span>
          <img src={signatureUrl} alt="CEO Signature" />
        </div>
      </div>
      <div class="ceo-img">
        <picture>
          <source media="(max-width: 767.98px)" srcset={ceoImageUrl} />
          <img src={ceoImageUrl} alt={`${ceoTitle} ${ceoName}`} />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .ceo-section {
    padding: 5rem 0 6rem;
    background-color: #fff;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    padding-bottom: 2.6rem;
  }

  .section-header h3 {
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--primary-header-color);
    margin-bottom: 1.5rem;
  }

  .header-line {
    display: block;
    width: 4rem;
    height: 0.3rem;
    background: var(--brand-color-gradient);
    margin: 0 auto;
  }

  .section-content {
    max-width: 81.1rem;
    margin: auto;
    display: flex;
    gap: 0.6rem;
  }

  .align-left {
    color: #444;
    font-size: 14px;
    font-weight: 400;
    line-height: 17px;
    letter-spacing: 0.56px;
  }

  .quote {
    color: #333;
    text-align: center;
    font-size: 27px;
    font-weight: 400;
    line-height: 34px;
    margin: 4rem 0 3.2rem;
  }

  .message-text {
    font-size: 1.4rem;
    color: var(--primary-text-color);
    line-height: 1.8;
  }

  .message-text :global(p) {
    margin-bottom: 2rem;
  }

  .ceo-message-content > div:last-child {
    margin-top: 6.6rem;
  }

  .ceo-signature {
    text-align: right;
  }

  .ceo-signature span {
    display: block;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--primary-header-color);
    margin-bottom: 1rem;
  }

  .ceo-signature img {
    max-width: 200px;
    height: auto;
    margin-left: auto;
  }

  .ceo-img {
    min-width: 21.2rem;
    max-width: 21.2rem;
    margin: 0 auto;
    position: relative;
  }

  .ceo-img picture {
    display: block;
  }

  .ceo-img img {
    min-width: 35rem;
    mix-blend-mode: multiply;
  }

  @media (max-width: 767px) {
    .ceo-section {
      padding: 4rem 0;
    }

    .section-header h3 {
      font-size: 2rem;
    }

    .section-content {
      flex-direction: column-reverse;
      padding-top: 2.5rem;
    }

    .quote {
      text-align: center;
      font-size: 2.4rem;
    }

    .ceo-img {
      text-align: center;
    }

    .ceo-img img {
      max-width: 25.2rem !important;
      min-width: auto;
    }

    .ceo-signature {
      text-align: center;
    }

    .ceo-signature img {
      margin: 0 auto;
    }
  }
</style>
