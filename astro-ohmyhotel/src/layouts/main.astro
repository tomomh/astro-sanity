---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

export interface Props {
  content: {
    title: string;
  };
  lang?: string;
}

const { content, lang = 'en' } = Astro.props;

// Get current path from URL
const currentPath = Astro.url.pathname;

// Extract language from path if not provided
const pathLang = currentPath.split('/')[1];
const currentLang = ['en', 'ja', 'ko', 'vi'].includes(pathLang) ? pathLang : lang;
---

<html lang={currentLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{content.title}</title>
	</head>
	<body>
		<Header currentLang={currentLang} currentPath={currentPath} />
		<main class="main-content">
			<slot />
		</main>
		<Footer currentLang={currentLang} />
	</body>
</html>

<style>
  .main-content {
    padding-top: 7.5rem; /* Account for fixed header height */
    min-height: calc(100vh - 7.5rem);
  }
</style>
